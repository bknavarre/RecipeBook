rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // username -> email lookup so people can log in with a username.
    // Anyone can look up ONE username (needed before login), nobody can list them all.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && name.matches('^[a-z0-9_.]{3,20}$');
      allow update, delete: if false;
    }

    // Each person can only read and write their own data.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
